:root {
  --bg: #f6fbf9;
  --white: #ffffff;
  --ink: #1d2b27;
  --muted: #64756f;
  --line: #e1efe9;
  --mint: #3ec99a;
  --mint-dark: #14896a;
  --mint-deep: #0e6f55;
  --mint-soft: #e6f8f1;
  --mint-mid: #bdeedb;
  --amber: #a5670b;
  --amber-soft: #fff3dc;
  --blue: #2463b8;
  --blue-soft: #e5effc;
  --red: #c73a3a;
  --red-soft: #fdeaea;
  --gray-soft: #f1f4f3;
  --r1: #d23b3b; --r2: #e5711a; --r3: #e0b000; --r4: #2e9a58; --r5: #2f6ccc;
  --shadow: 0 1px 2px rgba(20, 80, 60, .04), 0 4px 16px rgba(20, 80, 60, .06);
  --radius: 16px;
  color-scheme: light;
}

* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; }
body { background: var(--bg); color: var(--ink); font: 15.5px/1.5 'DM Sans', 'Segoe UI', system-ui, sans-serif; }
button, input, select { font: inherit; color: inherit; }
button { cursor: pointer; }
h1, h2, h3 { margin: 0; letter-spacing: -.01em; font-weight: 700; }
a { color: var(--mint-dark); }

.app { display: flex; min-height: 100vh; }


.sidebar {
  width: 232px; flex-shrink: 0; background: var(--white); border-right: 1px solid var(--line);
  display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh;
}
.brand { display: flex; gap: 12px; align-items: center; padding: 22px 20px 20px; }
.logo { width: 40px; height: 40px; border-radius: 12px; background: var(--mint); display: grid; place-items: center; }
.brand strong { display: block; font-size: 17px; letter-spacing: .03em; }
.brand span { font-size: 12.5px; color: var(--muted); }
.nav { display: flex; flex-direction: column; gap: 4px; padding: 6px 12px; flex: 1; }
.nav a {
  display: flex; align-items: center; gap: 12px; border: 0; background: transparent; color: var(--ink);
  padding: 11px 14px; border-radius: 12px; text-align: left; font-weight: 500; font-size: 15px;
}
.nav a:hover { background: var(--gray-soft); }
.nav a.active { background: var(--mint-soft); color: var(--mint-deep); font-weight: 700; }
.nav svg { width: 20px; height: 20px; flex-shrink: 0; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.nav em { margin-left: auto; font-style: normal; font-size: 12.5px; font-weight: 700; background: var(--mint-mid); color: var(--mint-deep); min-width: 24px; text-align: center; padding: 0 7px; border-radius: 99px; }
.nav em:empty { display: none; }
.sidebar-foot { padding: 14px 16px 20px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; }
.sidebar-foot .note { font-size: 12px; color: var(--muted); text-align: center; }


.main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.topbar {
  display: flex; align-items: center; gap: 16px; padding: 16px 32px; background: var(--white);
  border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5;
}
.titles { flex: 1; min-width: 0; }
.titles h1 { font-size: 22px; }
.titles p { margin: 0; color: var(--muted); font-size: 14px; }
.menu-btn { display: none; border: 0; background: none; font-size: 24px; padding: 4px 8px; }
.search { display: flex; align-items: center; background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 0 4px 0 12px; }
.search input { border: 0; background: transparent; width: 190px; height: 40px; outline: none; }
.search button { border: 0; background: var(--mint-dark); color: #fff; border-radius: 9px; padding: 6px 12px; font-weight: 600; font-size: 14px; }
.search:focus-within { border-color: var(--mint); box-shadow: 0 0 0 3px var(--mint-soft); }
.clock { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--muted); font-size: 15px; }

.view { padding: 28px 32px 56px; display: flex; flex-direction: column; gap: 22px; max-width: 1360px; width: 100%; }


.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid transparent;
  background: var(--mint-dark); color: #fff; font-weight: 700; border-radius: 12px; padding: 11px 18px; transition: background .15s;
}
.btn:hover { background: var(--mint-deep); }
.btn:disabled { background: #b8cfc7; cursor: not-allowed; }
.btn.small { padding: 7px 13px; font-size: 14px; border-radius: 10px; }
.btn.big { padding: 16px 28px; font-size: 17px; border-radius: 14px; }
.btn.light { background: var(--white); color: var(--ink); border-color: var(--line); font-weight: 600; }
.btn.light:hover { background: var(--gray-soft); }
.btn.soft { background: var(--mint-soft); color: var(--mint-deep); }
.btn.soft:hover { background: var(--mint-mid); }
.btn.red { background: var(--white); color: var(--red); border-color: #f2cccc; font-weight: 600; }
.btn.red:hover { background: var(--red-soft); }
.btn.block { width: 100%; }
.icon-btn { border: 0; background: none; font-size: 20px; color: var(--muted); padding: 4px 10px; border-radius: 8px; }
.icon-btn:hover { background: var(--gray-soft); }


.card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 22px; min-width: 0; }
.card h2 { font-size: 17px; }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
.sub { color: var(--muted); font-size: 13.5px; margin: 2px 0 0; }
.grid { display: grid; gap: 22px; }
.g2 { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
.g-form { grid-template-columns: 340px minmax(0, 1fr); align-items: start; }

.kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.kpi { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; box-shadow: var(--shadow); display: flex; align-items: center; gap: 14px; }
.kpi .dot { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; font-weight: 800; font-size: 20px; background: var(--k-bg); color: var(--k); flex-shrink: 0; }
.kpi .label { font-size: 13.5px; color: var(--muted); }
.kpi .value { font-size: 26px; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }


.form { display: flex; flex-direction: column; gap: 16px; }
.field { display: flex; flex-direction: column; gap: 6px; }
.field label, .field .lbl { font-size: 14px; font-weight: 600; }
.field .help { font-size: 12.5px; color: var(--muted); }
.field input, .field select {
  border: 1px solid var(--line); background: var(--bg); border-radius: 11px; padding: 11px 13px; width: 100%;
}
.field input:focus, .field select:focus { outline: none; border-color: var(--mint); box-shadow: 0 0 0 3px var(--mint-soft); background: var(--white); }
.risk-picker { display: flex; flex-direction: column; gap: 6px; }
.risk-picker label { cursor: pointer; display: block; }
.risk-picker input { position: absolute; opacity: 0; pointer-events: none; }
.risk-picker span {
  display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 11px;
  border: 2px solid var(--line); font-weight: 600; font-size: 14.5px; background: var(--white);
}
.risk-picker span i { width: 14px; height: 14px; border-radius: 50%; background: var(--rc); flex-shrink: 0; }
.risk-picker span small { margin-left: auto; color: var(--muted); font-weight: 500; }
.risk-picker input:checked + span { border-color: var(--rc); background: color-mix(in srgb, var(--rc) 9%, white); }
.risk-picker input:focus-visible + span { outline: 3px solid var(--mint-mid); }
details.more summary { cursor: pointer; font-size: 13.5px; color: var(--mint-dark); font-weight: 600; }
details.more[open] summary { margin-bottom: 8px; }


.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 15px; }
th { text-align: left; font-size: 12.5px; color: var(--muted); font-weight: 600; padding: 8px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; }
td { padding: 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }
tr:last-child td { border-bottom: 0; }
tbody tr:hover td { background: #fafdfc; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
.tnum { font-variant-numeric: tabular-nums; }
.id { font-variant-numeric: tabular-nums; color: var(--muted); font-weight: 600; }
.actions { display: flex; gap: 6px; justify-content: flex-end; flex-wrap: wrap; }
.empty { text-align: center; color: var(--muted); padding: 30px 10px; }
.clickable { cursor: pointer; }


.risk { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14px; white-space: nowrap; }
.risk i { width: 12px; height: 12px; border-radius: 50%; background: var(--rc); flex-shrink: 0; }
.rc1 { --rc: var(--r1); } .rc2 { --rc: var(--r2); } .rc3 { --rc: var(--r3); } .rc4 { --rc: var(--r4); } .rc5 { --rc: var(--r5); }
.status { display: inline-block; font-size: 13px; font-weight: 600; padding: 3px 11px; border-radius: 99px; white-space: nowrap; }
.st-wait { background: var(--amber-soft); color: var(--amber); }
.st-serv { background: var(--blue-soft); color: var(--blue); }
.st-done, .st-avail { background: var(--mint-soft); color: var(--mint-deep); }
.st-cancel { background: var(--gray-soft); color: var(--muted); }
select.risk-select {
  border: 2px solid var(--rc); background: color-mix(in srgb, var(--rc) 8%, white); border-radius: 10px;
  padding: 6px 10px; font-weight: 600; font-size: 14px; cursor: pointer;
}

.chips { display: flex; gap: 6px; flex-wrap: wrap; }
.chip { border: 1px solid var(--line); background: var(--white); border-radius: 99px; padding: 5px 14px; font-size: 14px; }
.chip:hover { background: var(--gray-soft); }
.chip.on { background: var(--mint-dark); color: #fff; border-color: var(--mint-dark); }


.hero { background: linear-gradient(135deg, var(--mint-soft), var(--white) 70%); border-color: var(--mint-mid); }
.next-call { display: grid; grid-template-columns: 1fr auto 1fr auto; gap: 18px; align-items: center; }
.slot { background: var(--white); border: 1px solid var(--line); border-radius: 14px; padding: 14px 18px; min-height: 92px; }
.slot .k { font-size: 13px; color: var(--muted); font-weight: 600; }
.slot .n { font-weight: 700; font-size: 19px; margin: 2px 0 4px; }
.slot .m { font-size: 14px; color: var(--muted); display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
.slot.warn { border-color: #f2cccc; background: var(--red-soft); }
.slot.warn .n { color: var(--red); }
.arrow { font-size: 26px; color: var(--mint); font-weight: 700; }


.att-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 14px; }
.att { border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; background: var(--white); border-left: 5px solid var(--rc); display: flex; flex-direction: column; gap: 8px; }
.att .who { font-weight: 700; font-size: 17px; }
.att .doc { font-size: 14.5px; color: var(--muted); }
.att .doc b { color: var(--ink); }
.att .row { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
.att .timer { font-variant-numeric: tabular-nums; font-weight: 700; color: var(--mint-dark); }
.att .btns { display: flex; gap: 8px; margin-top: 6px; }
.att .btns .btn { flex: 1; }

.list { display: flex; flex-direction: column; }
.li { display: flex; align-items: center; gap: 12px; padding: 11px 2px; border-bottom: 1px solid var(--line); }
.li:last-child { border-bottom: 0; }
.li .pos { width: 30px; height: 30px; border-radius: 9px; background: var(--mint-soft); color: var(--mint-deep); display: grid; place-items: center; font-size: 13.5px; font-weight: 700; flex-shrink: 0; }
.li .grow { flex: 1; min-width: 0; }
.li .t { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.li .s { font-size: 13px; color: var(--muted); }

.bars { display: flex; flex-direction: column; gap: 12px; }
.bar { display: grid; grid-template-columns: 130px 1fr 40px; gap: 12px; align-items: center; font-size: 14px; }
.bar .track { height: 12px; background: var(--gray-soft); border-radius: 99px; overflow: hidden; }
.bar .fill { height: 100%; background: var(--bc, var(--mint)); border-radius: 99px; }
.bar .v { text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }

.log { font-size: 14px; }
.log .li { align-items: flex-start; }
.log time { color: var(--muted); font-variant-numeric: tabular-nums; flex-shrink: 0; width: 70px; }


.steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 6px; }
.step { border: 1px solid var(--line); border-radius: 14px; padding: 18px; background: var(--white); display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
.step .n { width: 32px; height: 32px; border-radius: 50%; background: var(--mint); color: #fff; display: grid; place-items: center; font-weight: 800; }
.step.done .n { background: var(--mint-deep); }
.step p { margin: 0; color: var(--muted); font-size: 14px; flex: 1; }


dialog { border: 0; border-radius: 18px; padding: 0; width: min(500px, calc(100vw - 32px)); background: var(--white); color: var(--ink); box-shadow: 0 30px 80px rgba(10, 50, 40, .25); }
dialog::backdrop { background: rgba(20, 50, 40, .35); }
.modal-head { display: flex; align-items: center; justify-content: space-between; padding: 18px 22px 0; }
.modal-head h3 { font-size: 19px; }
#modalBody { padding: 14px 22px 22px; }
.kv { display: grid; grid-template-columns: 140px 1fr; gap: 9px 14px; font-size: 15px; }
.kv dt { color: var(--muted); }
.kv dd { margin: 0; }
.choice { display: flex; flex-direction: column; gap: 10px; margin-top: 16px; }
.choice .btn { justify-content: flex-start; text-align: left; padding: 14px 16px; }
.choice .btn small { display: block; font-weight: 500; opacity: .8; }
.toasts { position: fixed; right: 20px; bottom: 20px; display: flex; flex-direction: column; gap: 8px; z-index: 50; max-width: min(420px, calc(100vw - 40px)); }
.toast { background: var(--white); color: var(--ink); padding: 13px 16px; border-radius: 12px; font-size: 14.5px; box-shadow: 0 8px 30px rgba(10, 50, 40, .18); border-left: 5px solid var(--mint); animation: tin .2s ease; }
.toast.err { border-left-color: var(--red); }
@keyframes tin { from { opacity: 0; transform: translateY(8px); } }


@media (max-width: 1150px) {
  .g-form, .g2 { grid-template-columns: minmax(0, 1fr); }
  .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 900px) {
  .sidebar { position: fixed; left: 0; top: 0; z-index: 20; transform: translateX(-100%); transition: transform .2s; }
  .sidebar.open { transform: none; box-shadow: 0 0 60px rgba(0, 0, 0, .2); }
  .menu-btn { display: block; }
  .next-call, .steps { grid-template-columns: minmax(0, 1fr); }
  .arrow { transform: rotate(90deg); justify-self: center; }
  .topbar { padding: 12px 16px; flex-wrap: wrap; }
  .view { padding: 18px 16px 44px; }
  .clock { display: none; }
}
@media (max-width: 560px) {
  .search { order: 5; width: 100%; }
  .search input { flex: 1; width: auto; }
  .kpi { padding: 14px; }
  .bar { grid-template-columns: 110px 1fr 34px; }
  .kv { grid-template-columns: 1fr; gap: 2px; }
  .kv dd { margin-bottom: 8px; }
}


.nav a { text-decoration: none; }
a.btn { text-decoration: none; }
a.li { color: inherit; text-decoration: none; }
a.li:hover { background: #fafdfc; }
a.rowlink { color: var(--ink); font-weight: 700; text-decoration: none; }
a.rowlink:hover { color: var(--mint-dark); text-decoration: underline; }
.att a.who { color: var(--ink); text-decoration: none; }
.att .btns > * { flex: 1; display: flex; }
.att .btns form .btn { width: 100%; }
td .pos { width: 30px; height: 30px; border-radius: 9px; background: var(--mint-soft); color: var(--mint-deep); display: grid; place-items: center; font-size: 13.5px; font-weight: 700; }
form.inline { display: inline-flex; gap: 6px; align-items: center; margin: 0; }
.narrow { max-width: 560px; }
.narrow h2 { margin-bottom: 6px; }
.choice form { margin: 0; }
.choice form .btn { width: 100%; }
.next-call form { margin: 0; }


.toast { animation: tin .2s ease, tout .4s ease 4.5s forwards; }
@keyframes tout { to { opacity: 0; transform: translateY(8px); visibility: hidden; } }


.menu-toggle { position: absolute; opacity: 0; pointer-events: none; }
.menu-btn { cursor: pointer; user-select: none; }
.menu-backdrop { display: none; }
@media (max-width: 900px) {
  .menu-toggle:checked + .app .sidebar { transform: none; box-shadow: 0 0 60px rgba(0, 0, 0, .2); }
  .menu-toggle:checked + .app .menu-backdrop { display: block; position: fixed; inset: 0; z-index: 15; background: rgba(20, 50, 40, .3); }
}

.notice { border-radius: 12px; padding: 12px 16px; font-size: 14.5px; display: flex; gap: 10px; align-items: flex-start; }
.notice.ok { background: var(--mint-soft); color: var(--mint-deep); }
.notice.bad { background: var(--red-soft); color: var(--red); }
.stats { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
.stat { background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 5px 11px; font-size: 13px; }
.stat b { font-variant-numeric: tabular-nums; }
.tree-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); }
.tree-wrap svg { display: block; }
.tree-wrap .edge { stroke: #9fb8af; stroke-width: 1.5; }
.tree-wrap .node circle { stroke: #fff; stroke-width: 2; }
.tree-wrap .node.vermelho circle { fill: #d23b3b; }
.tree-wrap .node.preto circle { fill: #26302d; }
.tree-wrap .node.avl circle { fill: var(--mint-dark); }
.tree-wrap .node text { fill: #fff; text-anchor: middle; font-family: 'DM Sans', sans-serif; }
.tree-wrap .node .t1 { font-size: 12px; font-weight: 700; }
.tree-wrap .node .t2 { font-size: 9px; opacity: .9; }
.heap-levels { display: flex; flex-direction: column; gap: 8px; align-items: center; overflow-x: auto; padding: 4px; }
.heap-level { display: flex; gap: 6px; }
.hcell { border: 1px solid var(--line); background: var(--bg); border-radius: 9px; padding: 4px 8px; font-size: 12px; text-align: center; min-width: 64px; border-top: 3px solid var(--rc, var(--mint)); }
.hcell.root { box-shadow: 0 0 0 2px var(--mint); background: var(--mint-soft); }
.hcell .i { color: var(--muted); font-size: 10.5px; display: block; }
.hcell b { display: block; font-size: 13px; }
.buckets { display: flex; flex-direction: column; gap: 3px; max-height: 320px; overflow: auto; font-size: 12.5px; }
.bucket { display: flex; align-items: center; gap: 6px; min-height: 24px; }
.bucket .bi { width: 34px; text-align: right; color: var(--muted); font-variant-numeric: tabular-nums; flex-shrink: 0; }
.bucket .slotline { flex: 1; display: flex; align-items: center; gap: 4px; border-left: 2px solid var(--line); padding-left: 8px; flex-wrap: wrap; }
.bucket .k { background: var(--white); border: 1px solid var(--line); border-radius: 6px; padding: 0 7px; font-weight: 600; }
.bucket.col .k { border-color: #e0b000; background: var(--amber-soft); color: var(--amber); }
.bucket .ar { color: var(--muted); }
